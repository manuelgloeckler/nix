{
  "global": {
    "show_in_menu_bar": false,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "complex_modifications": {
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 250,
          "basic.to_if_held_down_threshold_milliseconds": 250
        },
        "rules": [
          {
            "description": "External keyboard: §/± key (next to Shift) → `/~ like MacBook",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "non_us_backslash", "modifiers": { "optional": [ "any" ] } },
                "to": [ { "key_code": "grave_accent_and_tilde" } ]
              }
            ]
          },
          {
            "description": "Caps Lock → Esc (tap) / Hyper (hold: ctrl+opt+cmd)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "caps_lock", "modifiers": { "optional": [ "any" ] } },
                "to": [ { "key_code": "left_control", "modifiers": [ "left_command", "left_option" ] } ],
                "to_if_alone": [ { "key_code": "escape" } ]
              }
            ]
          },
          {
            "description": "Map media keys to F1–F12 (for external keyboards)",
            "manipulators": [
              { "type": "basic", "from": { "consumer_key_code": "display_brightness_decrement" }, "to": [ { "key_code": "f1" } ] },
              { "type": "basic", "from": { "consumer_key_code": "display_brightness_increment" }, "to": [ { "key_code": "f2" } ] },
              { "type": "basic", "from": { "key_code": "mission_control" }, "to": [ { "key_code": "f3" } ] },
              { "type": "basic", "from": { "key_code": "launchpad" }, "to": [ { "key_code": "f4" } ] },
              { "type": "basic", "from": { "consumer_key_code": "illumination_decrement" }, "to": [ { "key_code": "f5" } ] },
              { "type": "basic", "from": { "consumer_key_code": "illumination_increment" }, "to": [ { "key_code": "f6" } ] },
              { "type": "basic", "from": { "consumer_key_code": "rewind" }, "to": [ { "key_code": "f7" } ] },
              { "type": "basic", "from": { "consumer_key_code": "play_or_pause" }, "to": [ { "key_code": "f8" } ] },
              { "type": "basic", "from": { "consumer_key_code": "fastforward" }, "to": [ { "key_code": "f9" } ] },
              { "type": "basic", "from": { "consumer_key_code": "mute" }, "to": [ { "key_code": "f10" } ] },
              { "type": "basic", "from": { "consumer_key_code": "volume_decrement" }, "to": [ { "key_code": "f11" } ] },
              { "type": "basic", "from": { "consumer_key_code": "volume_increment" }, "to": [ { "key_code": "f12" } ] }
            ]
          },
          {
            "description": "Ghostty: Ctrl+Space as tmux prefix without triggering macOS input switching",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "spacebar", "modifiers": { "mandatory": [ "control" ] } },
                "to": [ { "key_code": "b", "modifiers": [ "control" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.mitchellh\\.ghostty$" ] } ]
              }
            ]
          },
          {
            "description": "Chrome: Cmd+J/K to move between (vertical) tabs, Cmd+O to focus the address bar, Cmd+/ or Ctrl+Shift+F to find a tab",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "j", "modifiers": { "mandatory": [ "command" ] } },
                "to": [ { "key_code": "tab", "modifiers": [ "control" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.google\\.Chrome$" ] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "k", "modifiers": { "mandatory": [ "command" ] } },
                "to": [ { "key_code": "tab", "modifiers": [ "control", "shift" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.google\\.Chrome$" ] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "slash", "modifiers": { "mandatory": [ "command" ] } },
                "to": [ { "key_code": "a", "modifiers": [ "command", "shift" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.google\\.Chrome$" ] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "o", "modifiers": { "mandatory": [ "command" ] } },
                "to": [ { "key_code": "l", "modifiers": [ "command" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.google\\.Chrome$" ] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "f", "modifiers": { "mandatory": [ "control", "shift" ] } },
                "to": [ { "key_code": "a", "modifiers": [ "command", "shift" ] } ],
                "conditions": [ { "type": "frontmost_application_if", "bundle_identifiers": [ "^com\\.google\\.Chrome$" ] } ]
              }
            ]
          }
        ]
      },
      "simple_modifications": [],
      "devices": [],
      "virtual_hid_keyboard": {
        "country_code": 0,
        "keyboard_type": "ansi"
      }
    }
  ]
}
