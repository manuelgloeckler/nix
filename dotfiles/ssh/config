    ForwardAgent yes
    SetEnv TERM=ansi

Host ferranti-ts
    HostName ferranti-login001.tail30e3e7.ts.net
    User mgloeckler90
    ForwardAgent yes
    SetEnv TERM=ansi

Host muse-ts
