{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/system-prompt.md"
  ],
  "plugin": [
    "opencode-claude-auth@1.4.9",
    "opencode-pollinations-plugin@6.2.7-1",
    "@bdliyq/opencode-rate-limit-retry@1.0.3"
  ],
  "lsp": true,
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "external_directory": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow"
  },
  "provider": {
    "mlcloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ML Cloud",
      "options": {
        "baseURL": "https://llm.mlcloud.uni-tuebingen.de/v1",
        "apiKey": "{file:~/.config/opencode/mlcloud.key}"
      },
      "models": {
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B A3B",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "google/gemma-4-31B-it-qat-w4a16-ct": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "/bin/sh",
        "-lc",
        "GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token 2>/dev/null)\" exec github-mcp-server stdio"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "uv-mcp": {
      "type": "local",
      "command": [
        "/Users/manug/.local/bin/uv-mcp"
      ]
    },
    "agenthome": {
      "type": "local",
      "command": [
        "ah",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "AGENTHOME_HUB": "https://cockpit.tail30e3e7.ts.net:8443",
        "AGENTHOME_TOKEN_FILE": "/Users/manug/.agenthome/mcp/opencode.token"
      }
    }
  }
}
